{
  "name": "@manga-ai-studio/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "echo 'Use reviewable Prisma migrations instead of prisma db push.' && exit 1",
    "migrate:status": "prisma migrate status",
    "migrate:deploy": "prisma migrate deploy",
    "baseline:introspect:print": "prisma db pull --print --schema prisma/schema.prisma",
    "baseline:resolve:prod": "prisma migrate resolve --applied 20260410_080000_prod_legacy_baseline",
    "checks:legacy": "tsx prisma/run-legacy-prechecks.ts",
    "checks:hard-switch": "tsx prisma/run-hard-switch-postchecks.ts",
    "backfill:hard-switch": "tsx prisma/backfill-hard-switch.ts",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "lint": "echo ok"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
