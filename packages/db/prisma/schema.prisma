generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  user
  admin
}

enum ProjectStatus {
  draft
  active
  archived
}

enum ContentRating {
  GENERAL
  TEEN
  MATURE
  ADULT_RESTRICTED
}

/// Couches d'intensité contenu (spec delta)
enum ContentIntensityLayer {
  GENERAL_SAFE
  TEEN
  MATURE_DRAMA
  MATURE_VISUAL
  ADULT_EXPLICIT
  RESTRICTED_BLOCKED_VISUAL
}

enum RenderFamily {
  manga
  anime
  semi_realistic
  gothic
  horror
  western
}

enum LineWeight {
  fine
  medium
  heavy
}

enum ShadingMode {
  cel_shading
  ink_bw
  hatching
  painterly
}

enum ContrastProfile {
  soft
  dramatic
  brutal
}

enum AnatomyBias {
  stylized
  grounded
  realistic
}

enum BackgroundDensity {
  low
  medium
  high
}

enum CameraLanguage {
  cinematic
  manga_dynamic
  intimate
  horror_claustrophobic
}

enum RenderingMode {
  CHARACTER_SHEET
  CHARACTER_EXPRESSION_SET
  OUTFIT_VARIATION
  LOCATION_KEYFRAME
  SCENE_KEYFRAME
  STYLE_FRAME
  PANEL_DRAFT
  PANEL_FINAL
  COVER_ART
  INPAINT_FIX
  POSE_LOCK_VARIATION
  STYLE_TRANSFER_VARIATION
}

enum CanonPackSlot {
  face_portrait
  full_body_front
  full_body_three_quarter
  side_profile
  expression_1
  expression_2
  expression_3
  expression_4
  expression_5
  expression_6
  pose_1
  pose_2
  pose_3
  outfit_standard
  outfit_variant
}

enum JobType {
  BUILD_PROJECT_CONTEXT
  GENERATE_CHARACTER_PROFILE
  GENERATE_CHARACTER_VISUAL
  GENERATE_STYLE_PACK_ASSETS
  GENERATE_CHARACTER_CANON_PACK
  GENERATE_CHAPTER_OUTLINE
  GENERATE_CHAPTER_SCRIPT
  GENERATE_DIALOGUES
  GENERATE_STORYBOARD
  GENERATE_SCENE_KEY_ART
  RENDER_PANEL_DRAFT
  RENDER_PANEL_FINAL
  IMAGE_INPAINT_FIX
  IMAGE_UPSCALE
  GENERATE_SCENE_IMAGES
  UPDATE_MEMORY
  RUN_CANON_VALIDATION
  COMPUTE_CONSISTENCY_SCORE
  EXPORT_PDF
}

enum JobStatus {
  queued
  running
  waiting_external
  partial_success
  completed
  failed
  canceled
  refunded
}

enum WalletTransactionType {
  purchase
  debit
  refund
  adjustment
}

enum MediaAssetType {
  character_ref
  face_crop
  action_ref
  npc_ref
  scene_keyframe
  panel_output
  training_zip
  lora_weights
  lora_config
  trace_payload
  trace_response
  other
}

enum MediaAssetOrigin {
  user_upload
  generated
  fal_upload
  fal_output
  derived_crop
  system
}

enum FalMode {
  text2img
  img2img
  lora_training
}

enum FalTraceStatus {
  submitted
  running
  completed
  failed
  timeout
  canceled
}

enum NpcImportanceLevel {
  generic
  recurring
  important
}

enum NpcPromotionStatus {
  candidate
  promoted
  locked
}

model User {
  id             String    @id @default(cuid())
  /// Identifiant auth.users Supabase (SSO / magic link)
  supabaseAuthId String?   @unique
  email          String    @unique
  displayName    String?
  role           UserRole  @default(user)
  locale         String    @default("fr")
  ageVerifiedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  preferences    UserPreferences?
  projects       Project[]
  jobs           Job[]
  wallets        Wallet[]
  stripeOrders   StripeOrder[]
  moderationEvents ModerationEvent[]
  adminFlags     AdminFlag[]
}

model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultLanguage       String   @default("fr")
  matureContentEnabled  Boolean  @default(false)
  preferredGenres       Json     @default("[]")
  preferredVisualStyle  String?
}

model Project {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  slug            String         @unique
  pitch           String?
  description     String?
  primaryGenre    String?
  subGenres       Json           @default("[]")
  tone            String?
  format          String?
  contentRating   ContentRating  @default(GENERAL)
  intensityLayer  ContentIntensityLayer @default(GENERAL_SAFE)
  visualStyle     String?
  status          ProjectStatus  @default(draft)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  settings        ProjectSettings?
  stylePacks      StylePack[]
  storyBible      StoryBible?
  characters      Character[]
  relationships   CharacterRelationship[]
  locations       Location[]
  items           Item[]
  arcs            Arc[]
  chapters        Chapter[]
  continuityEvents ContinuityEvent[]
  memorySnapshots MemorySnapshot[]
  ragDocuments    RagDocument[]
  jobs            Job[]
  loraModels      LoraModel[]
  loraAttachments LoraAttachment[] @relation("ProjectLoras")
  mediaAssets     MediaAsset[]
  falTraces       FalTrace[]
  characterVisualLocks CharacterVisualLock[]
  npcVisualProfiles NpcVisualProfile[]
  sceneKeyframes  SceneKeyframe[]
  chapterCanonStates ChapterCanonState[]
  sceneStates     SceneState[]
  canonTimelineEvents CanonTimelineEvent[]
  canonChangeRequests CanonChangeRequest[]
}

model ProjectSettings {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  violenceLevel      Int      @default(0)
  romanceLevel       Int      @default(0)
  sensualityLevel    Int      @default(0)
  darknessLevel      Int      @default(0)
  mysteryLevel       Int      @default(0)
  realismLevel       Int      @default(0)
  pacingLevel        Int      @default(0)
  dialogueDensity    Int      @default(0)
  maxTokensPerJob    Int      @default(10000)
  canonStrictness    Int      @default(80)
}

model StylePack {
  id                  String           @id @default(cuid())
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version             Int              @default(1)
  renderFamily        RenderFamily     @default(manga)
  lineWeight          LineWeight       @default(medium)
  shadingMode         ShadingMode      @default(ink_bw)
  contrastProfile     ContrastProfile  @default(dramatic)
  anatomyBias         AnatomyBias      @default(stylized)
  backgroundDensity   BackgroundDensity @default(medium)
  cameraLanguage      CameraLanguage   @default(manga_dynamic)
  approvedLoraIds     Json             @default("[]")
  negativeConstraints Json             @default("[]")
  styleRefImageUrl    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  loraAttachments     LoraAttachment[] @relation("StylePackLoras")
}

model StoryBible {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version      Int      @default(1)
  summary      String?
  worldRules   Json     @default("{}")
  themes       Json     @default("[]")
  lore         Json     @default("{}")
  glossary     Json     @default("{}")
  lockedCanon  Json     @default("{}")
  createdAt    DateTime @default(now())
}

model Character {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  roleType        String?
  age             Int?
  adultVerified   Boolean   @default(false)
  // Important pour la génération IA : homme / femme (valeur simple, stable)
  gender          String?
  autoGenerated   Boolean   @default(false)
  pronouns        String?
  biography       String?
  objective       String?
  fear            String?
  trauma          String?
  personality     Json      @default("{}")
  traits          Json      @default("[]")
  flaws           Json      @default("[]")
  secrets         Json      @default("[]")
  appearance      String?
  hairColor       String?
  eyeColor        String?
  outfitDefault   String?
  bodyProfile     Json      @default("{}")
  // Profils structurés avancés (LOT 2 + continuity engine)
  visualProfile       Json  @default("{}")
  bodyState           Json  @default("{}")
  wardrobeProfile     Json  @default("{}")
  speechProfile       Json  @default("{}")
  continuityProfile   Json  @default("{}")
  adultContentProfile Json  @default("{}")

  // DialogueVoiceProfile : profil de voix persistante pour cohérence dialogue
  voiceRegister         String?  // very_formal, formal, neutral, casual, rough
  voiceSentenceLength   String?  // very_short, short, medium, long
  voiceVocabularyStyle  String?  // ex: "poétique", "technique", "argot", etc.
  voiceEmotionalLeak    Float?   // 0.0 à 1.0 : niveau d'expressivité émotionnelle
  voiceSarcasmLevel     Float?   // 0.0 à 1.0
  voiceAggressionLevel  Float?   // 0.0 à 1.0
  voiceSilenceFrequency Float?   // 0.0 à 1.0 : tendance au silence
  voiceFavoriteExpressions   Json @default("[]")  // Array<string> : expressions favorites
  voiceForbiddenExpressions  Json @default("[]")  // Array<string> : expressions interdites
  voiceForbiddenPatterns     Json @default("[]")  // Array<string> : patterns de discours interdits
  voiceThreatenStyle    String?  // "direct", "subtil", "froid", etc.
  voiceLieStyle         String?  // "omission", "misdirection", "bold", etc.
  voiceSeductionStyle   String?  // "charming", "aggressive", "shy", etc.
  voiceInnerMonologueStyle String? // style des pensées intérieures
  voiceExamplesCanonical Json @default("[]")  // Array<{context, line, emotion}> : exemples canoniques de dialogues
  voiceSpeechRules      Json @default("[]")  // Array<string> : règles textuelles strictes

  // StableIdentity : traits visuels et psycho verrouillés (non modifiables sans CanonChangeRequest)
  stableVisualDNA       Json @default("{}")  // hairColor, eyeColor, faceShape, silhouette, scars, tattoos, fixedAccessories, forbiddenVisualDrift
  stableSpeechDNA       Json @default("{}")  // register, sentenceLength, vocabularyStyle, favoriteExpressions, forbiddenExpressions
  stablePsycheDNA       Json @default("{}")  // coreDesire, coreFear, internalLie, moralLine, fatalFlaw

  // ChangePolicy : quels changements sont autorisés sans validation
  canChangeHair         Boolean @default(false)
  canChangeOutfitFreely Boolean @default(true)
  canChangeVisibleScars Boolean @default(false)
  canChangeSpeechRegister Boolean @default(false)
  requiresCanonApprovalFor Json @default("[]")  // Array<string> : types de changements nécessitant un CanonChangeRequest
  
  // CharacterFingerprint : identité visuelle/comportementale stricte (Bloc 2)
  characterFingerprint  Json @default("{}")  // CharacterFingerprint complet

  // B7-1 : statut LoRA training automatique
  loraStatus        String?  @default("none")  // "none"|"training"|"ready"|"failed"
  loraReadyAt       DateTime?

  status          String    @default("alive")
  emotionalState  String?
  canonLocked     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  visualRefs      CharacterVisualRef[]
  mediaAssets     MediaAsset[]
  visualLocks     CharacterVisualLock[]
  falTraces       FalTrace[]
  npcProfiles     NpcVisualProfile[]
  canonPack       CharacterCanonPack?
  relationshipsFrom CharacterRelationship[] @relation("RelFrom")
  relationshipsTo   CharacterRelationship[] @relation("RelTo")
  ownedItems      Item[]
  loraAttachments LoraAttachment[] @relation("CharacterLoras")
  canonChangeRequests CanonChangeRequest[]

  @@unique([projectId, slug])
}

model CharacterVisualRef {
  id            String   @id @default(cuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  mediaAssetId  String?
  mediaAsset    MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  sourceVisualLockId String?
  sourceVisualLock CharacterVisualLock? @relation(fields: [sourceVisualLockId], references: [id], onDelete: SetNull)
  type          String
  imageUrl      String
  promptSnapshot String?
  metadata      Json     @default("{}")
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model CharacterCanonPack {
  id                    String    @id @default(cuid())
  characterId           String    @unique
  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  version               Int       @default(1)
  visualSignatureText   String?
  forbiddenVisualDrift  Json      @default("[]")
  completenessScore     Float     @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assets                CanonPackAsset[]
}

model CanonPackAsset {
  id        String         @id @default(cuid())
  packId    String
  pack      CharacterCanonPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  slot      CanonPackSlot
  imageUrl  String?
  refId     String?
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now())

  @@unique([packId, slot])
}

model LoraModel {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String
  name        String
  weightsMeta Json     @default("{}")
  weightsAssetId String?
  weightsAsset MediaAsset? @relation("LoraWeightsAsset", fields: [weightsAssetId], references: [id], onDelete: SetNull)
  configAssetId String?
  configAsset MediaAsset? @relation("LoraConfigAsset", fields: [configAssetId], references: [id], onDelete: SetNull)
  status      String   @default("active")
  createdAt   DateTime @default(now())

  attachments LoraAttachment[]
  visualLocks CharacterVisualLock[]
}

model LoraAttachment {
  id                   String    @id @default(cuid())
  loraId               String
  lora                 LoraModel @relation(fields: [loraId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?  @relation("ProjectLoras", fields: [projectId], references: [id], onDelete: Cascade)
  stylePackId          String?
  stylePack            StylePack? @relation("StylePackLoras", fields: [stylePackId], references: [id], onDelete: Cascade)
  characterId          String?
  character            Character? @relation("CharacterLoras", fields: [characterId], references: [id], onDelete: Cascade)
  weight               Float     @default(1)
  enabled              Boolean   @default(true)
  renderingModeFilter  Json      @default("[]")
  createdAt            DateTime  @default(now())
}

model CharacterRelationship {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceCharacterId String
  source            Character @relation("RelFrom", fields: [sourceCharacterId], references: [id], onDelete: Cascade)
  targetCharacterId String
  target            Character @relation("RelTo", fields: [targetCharacterId], references: [id], onDelete: Cascade)
  relationType      String
  intensity         Int      @default(50)
  reciprocityType   String   @default("bilateral")
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Location {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  slug           String?
  type           String?
  description    String?
  visualBrief    String?
  aliases        Json      @default("[]")
  parentId       String?
  parent         Location? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children       Location[] @relation("LocationHierarchy")
  metadata       Json      @default("{}")
  canonLocked    Boolean   @default(false)

  npcVisualProfiles NpcVisualProfile[]
}

model Item {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  type             String?
  description      String?
  ownerCharacterId String?
  owner            Character? @relation(fields: [ownerCharacterId], references: [id])
  state            Json     @default("{}")
  canonLocked      Boolean  @default(false)
}

model Arc {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  type              String?
  summary           String?
  status            String   @default("open")
  startChapterNumber Int?
  endChapterNumber   Int?
  metadata          Json     @default("{}")
}

model Chapter {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterNumber  Int
  title          String?
  status         String   @default("draft")
  studioStatus   String?
  studioCurrentStep String?
  studioUpdatedAt DateTime?
  studioAutosaveVersion Int?
  userIntent     String?
  outline        Json     @default("{}")
  script         Json     @default("{}")
  storyboard     Json     @default("{}")
  summary        String?
  cliffhanger    String?
  coverImageUrl  String?
  tokenEstimate  Int?
  tokenActual    Int?
  minimumImages  Int?
  generatedImages Int?
  acceptedImages Int?
  rejectedImages Int?
  missingImages  Int?
  criticalPanelsCount Int?
  criticalPanelsBlocked Int?
  criticalPanelsMissingQa Int?
  reviewBlockedReason String?
  // B6-3 : flag qualité outline faible
  qualityGateWarning Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  scenes         ChapterScene[]
  mediaAssets    MediaAsset[]
  continuityEvents ContinuityEvent[]
  memorySnapshots MemorySnapshot[]
  jobs           Job[]
  sceneKeyframes SceneKeyframe[]
  falTraces      FalTrace[]
  canonState     ChapterCanonState?
  canonTimelineEvents CanonTimelineEvent[]
  canonChangeRequests CanonChangeRequest[]
  sceneStates    SceneState[]

  @@unique([projectId, chapterNumber])
  @@index([projectId, studioStatus])
}

model ChapterScene {
  id         String   @id @default(cuid())
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sceneNumber Int
  title      String?
  summary    String?
  locationId String?
  beatId     String?
  script     Json     @default("{}")
  dialogue   Json     @default("{}")
  metadata   Json     @default("{}")

  images     SceneImage[]
  mediaAssets MediaAsset[]
  keyframes  SceneKeyframe[]
  npcVisualProfiles NpcVisualProfile[]
  falTraces  FalTrace[]
  sceneState SceneState?
}

model SceneImage {
  id                 String          @id @default(cuid())
  sceneId            String
  scene              ChapterScene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  panelNumber        Int
  renderingMode      RenderingMode   @default(PANEL_DRAFT)
  prompt             String?
  negativePrompt     String?
  provider           String?
  model              String?
  width              Int             @default(1024)
  height             Int             @default(1024)
  status             String          @default("pending")
  imageUrl           String?
  mediaAssetId       String?
  mediaAsset         MediaAsset?       @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  sceneKeyframeId    String?
  sceneKeyframe      SceneKeyframe?    @relation(fields: [sceneKeyframeId], references: [id], onDelete: SetNull)
  moderationStatus   String?
  routingDecision    Json?
  promptComposerPayload Json?
  consistencyScore   Float?
  referenceImageIds  Json            @default("[]")
  metadata           Json            @default("{}")
  // B1-1 : raison d'échec explicite (au lieu de swallowed dans metadata)
  failureReason      String?
  // B1-2 : retry automatique par criticité
  retryCount         Int             @default(0)
  maxRetries         Int             @default(2)
  // B1-3 : URL persistée dans Supabase (stable, pas temporaire fal.ai)
  persistedUrl       String?
  falTraces          FalTrace[]
}

model MediaAsset {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId     String?
  chapter       Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sceneId       String?
  scene         ChapterScene?    @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  characterId   String?
  character     Character?       @relation(fields: [characterId], references: [id], onDelete: SetNull)
  type          MediaAssetType
  origin        MediaAssetOrigin
  ownerType     String?
  ownerId       String?
  storageProvider String         @default("supabase")
  bucket        String?
  storageKey    String?
  publicUrl     String?
  signedUrl     String?
  falCdnUrl     String?
  sha256        String?
  mimeType      String?
  width         Int?
  height        Int?
  bytes         Int?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  characterRefs CharacterVisualRef[]
  imageOutputs  SceneImage[]
  sourceLocks   CharacterVisualLock[] @relation("VisualLockPrimaryAsset")
  faceCloseupLocks CharacterVisualLock[] @relation("VisualLockFaceCloseupAsset")
  actionRefLocks CharacterVisualLock[] @relation("VisualLockActionAsset")
  loraWeightModels LoraModel[] @relation("LoraWeightsAsset")
  loraConfigModels LoraModel[] @relation("LoraConfigAsset")
  sceneKeyframes SceneKeyframe[]
  npcProfiles    NpcVisualProfile[]
  falTraceRequestAssets FalTrace[] @relation("FalTraceRequestAsset")
  falTraceResponseAssets FalTrace[] @relation("FalTraceResponseAsset")

  @@index([projectId, type])
  @@index([projectId, type, ownerType, ownerId])
  @@index([chapterId])
  @@index([sceneId])
  @@index([characterId])
  @@unique([projectId, sha256])
}

model CharacterVisualLock {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterId     String
  character       Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  version         Int
  isActive        Boolean     @default(true)
  displayName     String
  shortVisualCore String
  triggerWord     String?
  loraModelId     String?
  loraModel       LoraModel?  @relation(fields: [loraModelId], references: [id], onDelete: SetNull)
  loraAssetId     String?
  loraAsset       MediaAsset? @relation("VisualLockPrimaryAsset", fields: [loraAssetId], references: [id], onDelete: SetNull)
  faceCloseupAssetId String?
  faceCloseupAsset MediaAsset? @relation("VisualLockFaceCloseupAsset", fields: [faceCloseupAssetId], references: [id], onDelete: SetNull)
  actionRefAssetId String?
  actionRefAsset  MediaAsset? @relation("VisualLockActionAsset", fields: [actionRefAssetId], references: [id], onDelete: SetNull)
  canonicalRefUrls Json       @default("[]")
  defaultOutfit   String?
  altOutfits      Json        @default("[]")
  currentState    Json        @default("{}")
  injuryState     Json        @default("{}")
  ageVariant      String?
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  visualRefs      CharacterVisualRef[]
  falTraces       FalTrace[]

  // Enforced in SQL migration reviewable:
  // unique active lock per character via partial unique index WHERE isActive = true
  @@unique([characterId, version])
  @@index([projectId, characterId, isActive])
}

model NpcVisualProfile {
  id                String              @id @default(cuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId           String?
  scene             ChapterScene?       @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  locationId        String?
  location          Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  characterId       String?
  character         Character?          @relation(fields: [characterId], references: [id], onDelete: SetNull)
  stableNpcId       String              @unique
  role              String
  shortVisualCore   String
  outfitSignature   String?
  silhouetteSignature String?
  accessoryMarker   String?
  relationToLocation String?
  importanceLevel   NpcImportanceLevel  @default(generic)
  promotionStatus   NpcPromotionStatus  @default(candidate)
  appearanceCount   Int                 @default(1)
  canonicalRefAssetId String?
  canonicalRefAsset MediaAsset?         @relation(fields: [canonicalRefAssetId], references: [id], onDelete: SetNull)
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  falTraces         FalTrace[]

  @@index([projectId, importanceLevel])
  @@index([sceneId])
  @@index([locationId])
  @@index([characterId])
}

model SceneKeyframe {
  id                  String       @id @default(cuid())
  projectId           String
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId           String
  chapter             Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sceneId             String
  scene               ChapterScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  version             Int
  selected            Boolean      @default(true)
  /// Primary source of truth for the persisted keyframe binary asset.
  imageAssetId        String?
  imageAsset          MediaAsset?  @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  /// Legacy/debug fallback URL, tolerated when no MediaAsset is available yet.
  imageUrl            String?
  involvedCharacterIds Json        @default("[]")
  environmentLock     Json         @default("{}")
  lightingLock        String?
  timeOfDay           String?
  compositionArchetype String?
  emotionalTone       String?
  combatMode          Boolean      @default(false)
  referenceCropAssetIds Json       @default("[]")
  metadata            Json         @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  derivedPanels       SceneImage[]
  falTraces           FalTrace[]

  // Enforced in SQL migration reviewable:
  // unique selected keyframe per scene via partial unique index WHERE selected = true
  @@unique([sceneId, version])
  @@index([projectId, chapterId, sceneId, selected])
}

model FalTrace {
  id                 String           @id @default(cuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId          String?
  chapter            Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sceneId            String?
  scene              ChapterScene?    @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  panelId            String?
  panel              SceneImage?      @relation(fields: [panelId], references: [id], onDelete: SetNull)
  characterId        String?
  character          Character?       @relation(fields: [characterId], references: [id], onDelete: SetNull)
  npcVisualProfileId String?
  npcVisualProfile   NpcVisualProfile? @relation(fields: [npcVisualProfileId], references: [id], onDelete: SetNull)
  sceneKeyframeId    String?
  sceneKeyframe      SceneKeyframe?   @relation(fields: [sceneKeyframeId], references: [id], onDelete: SetNull)
  visualLockId       String?
  visualLock         CharacterVisualLock? @relation(fields: [visualLockId], references: [id], onDelete: SetNull)
  provider           String
  model              String
  mode               FalMode
  status             FalTraceStatus   @default(submitted)
  requestId          String?
  jobId              String?
  requestAssetId     String?
  requestAsset       MediaAsset?      @relation("FalTraceRequestAsset", fields: [requestAssetId], references: [id], onDelete: SetNull)
  responseAssetId    String?
  responseAsset      MediaAsset?      @relation("FalTraceResponseAsset", fields: [responseAssetId], references: [id], onDelete: SetNull)
  requestPayload     Json             @default("{}")
  responsePayload    Json             @default("{}")
  refsUsed           Json             @default("[]")
  lorasUsed          Json             @default("[]")
  timings            Json             @default("{}")
  error              Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([projectId, chapterId, sceneId])
  @@index([panelId])
  @@index([sceneKeyframeId])
  @@index([characterId])
  @@index([status, createdAt])
}

model ContinuityEvent {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId     String?
  chapter       Chapter? @relation(fields: [chapterId], references: [id])
  eventType     String
  summary       String?
  entities      Json     @default("{}")
  importance    Int      @default(0)
  timelineOrder Int      @default(0)
  permanent     Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model MemorySnapshot {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId           String?
  chapter             Chapter? @relation(fields: [chapterId], references: [id])
  structuredState     Json     @default("{}")
  narrativeSummary    String?
  embeddingStatus     String   @default("pending")
  // Snapshots état personnages à la fin du chapitre (LOT 3)
  characterSnapshots  Json     @default("[]")
  wardrobeSnapshots   Json     @default("[]")
  relationshipSnapshots Json   @default("[]")
  openLoops           Json     @default("[]")
  visualContinuityWarnings Json @default("[]")
  createdAt           DateTime @default(now())
}

model RagDocument {
  id         String                      @id @default(cuid())
  projectId  String
  project    Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String?
  title      String?
  content    String
  metadata   Json                        @default("{}")
  embedding  Unsupported("vector(1536)")?
