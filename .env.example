# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev sans Supabase (ne pas utiliser en production)
AUTH_DISABLED=true

# Base Prisma (Supabase Postgres ou autre)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manga_ai_studio
# Supabase : en local si P1001 sur db.*:5432, utiliser Session pooler (port 5432 sur aws-*.pooler.supabase.com) ; voir le README
DIRECT_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (web)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# IA
FAL_KEY=
BFL_API_KEY=
RUNWARE_API_KEY=
STABILITY_API_KEY=
OPENAI_API_KEY=
# Modèle pour les outlines chapitre (défaut gpt-4o-mini)
# OPENAI_OUTLINE_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=
OPENAI_STRUCTURED_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_MODERATION_MODEL=

# Observabilité / analytics
POSTHOG_KEY=
SENTRY_DSN=
STORAGE_BUCKET=

# Optionnel rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
