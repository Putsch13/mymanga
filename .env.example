# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev sans Supabase (ne pas utiliser en production)
AUTH_DISABLED=true

# Base Prisma (Supabase Postgres ou autre)
# Runtime (transaction pool, port 6543) :
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Migrations Prisma (session pool, port 5432). Le host db.<ref>.supabase.co
# n'est plus accessible en IPv4 → toujours passer par le pooler en port 5432.
# Voir docs/runbooks/database-migrations.md
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (web)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# IA
FAL_KEY=
BFL_API_KEY=
RUNWARE_API_KEY=
STABILITY_API_KEY=
OPENAI_API_KEY=
# Modèle pour les outlines chapitre (défaut gpt-4o-mini)
# OPENAI_OUTLINE_MODEL=gpt-4o-mini
# Contrat visuel chapitre (extraction JSON premium V3). Défaut = gpt-4o-mini si absent.
# Exemples : gpt-4o-mini (économique), gpt-4o (meilleure fidélité au texte / beats).
# OPENAI_CHAPTER_VISUAL_CONTRACT_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=
OPENAI_STRUCTURED_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_MODERATION_MODEL=

# Observabilité / analytics
POSTHOG_KEY=
SENTRY_DSN=
STORAGE_BUCKET=

# Optionnel rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
