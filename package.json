{
  "name": "manga-ai-studio",
  "private": true,
  "scripts": {
    "frontend:dev": "pnpm --filter @manga-ai-studio/web dev",
    "frontend:build": "pnpm --filter @manga-ai-studio/web build",
    "frontend:start": "pnpm --filter @manga-ai-studio/web start",
    "backend:test": "pnpm --filter @manga-ai-studio/ai test",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @manga-ai-studio/db generate",
    "db:push": "pnpm --filter @manga-ai-studio/db push",
    "db:studio": "pnpm --filter @manga-ai-studio/db studio",
    "db:seed": "pnpm --filter @manga-ai-studio/db seed",
    "test": "pnpm --filter @manga-ai-studio/ai test"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.37"
  }
}
